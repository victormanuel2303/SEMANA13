import numpy as np
import matplotlib.pyplot as plt

# ==============================================================================
# SIMULADOR DE BAÑO MARÍA DE LABORATORIO (Python / Google Colab)
# ==============================================================================

# 1. Parámetros físicos del sistema
m_w = 2.5          # Masa de agua del baño (kg) -> aprox. 2.5 L
c_w = 4186.0       # Calor específico del agua (J / kg·°C)
m_s = 0.2          # Masa de la muestra (kg)
c_s = 4186.0       # Calor específico de la muestra (J / kg·°C)

P_max = 1000.0     # Potencia máxima de la resistencia eléctrica (W)
T_env = 22.0       # Temperatura ambiente (°C)
T_set = 37.0       # Consigna / Setpoint de incubación (°C)

k_env = 45.0       # Coeficiente de pérdidas térmicas al ambiente (W / °C)
k_ws = 85.0        # Coeficiente de transferencia de calor agua <-> muestra (W / °C)

# 2. Parámetros del controlador PID
Kp = 0.35          # Ganancia proporcional
Ki = 0.005         # Ganancia integral
Kd = 1.5           # Ganancia derivativa

# 3. Configuración de la simulación
t_total = 15 * 60  # Tiempo total en segundos (15 minutos)
dt = 0.5           # Paso de tiempo (s)
n_steps = int(t_total / dt)

t = np.linspace(0, t_total, n_steps)
t_min = t / 60.0   # Tiempo en minutos para las gráficas

# Arreglos para guardar resultados
Tw = np.zeros(n_steps)
Ts = np.zeros(n_steps)
u_hist = np.zeros(n_steps)
P_cal = np.zeros(n_steps)
P_perd = np.zeros(n_steps)
P_util = np.zeros(n_steps)
err_hist = np.zeros(n_steps)

# Condiciones iniciales
Tw[0] = T_env
Ts[0] = T_env
integral = 0.0
error_prev = T_set - Tw[0]

# 4. Bucle de simulación (Método de Euler)
for i in range(n_steps):
    # Error de regulación
    error = T_set - Tw[i]
    err_hist[i] = error
    
    # Término derivativo
    derivada = (error - error_prev) / dt if i > 0 else 0.0
    
    # Señal de control PID sin saturar
    u_raw = Kp * error + Ki * integral + Kd * derivada
    
    # Saturación de la señal de control u(t) en [0, 1]
    u = np.clip(u_raw, 0.0, 1.0)
    
    # Anti-windup: acumular integral solo si no está saturado o si ayuda a desaturar
    if (0.0 < u_raw < 1.0) or (u_raw >= 1.0 and error < 0) or (u_raw <= 0.0 and error > 0):
        integral += error * dt
        
    u_hist[i] = u * 100.0  # En porcentaje (%)
    error_prev = error
    
    # Balance de potencias (W)
    p_heater = u * P_max
    p_loss = k_env * (Tw[i] - T_env)
    p_sample = k_ws * (Tw[i] - Ts[i])
    
    P_cal[i] = p_heater
    P_perd[i] = p_loss
    P_util[i] = p_sample
    
    # Ecuaciones diferenciales (dos masas térmicas acopladas)
    if i < n_steps - 1:
        dTw_dt = (p_heater - p_loss - p_sample) / (m_w * c_w)
        dTs_dt = p_sample / (m_s * c_s)
        
        Tw[i + 1] = Tw[i] + dTw_dt * dt
        Ts[i + 1] = Ts[i] + dTs_dt * dt

# 5. Generación de gráficos
fig, axs = plt.subplots(2, 2, figsize=(13, 8))
fig.suptitle(f'Baño María — Incubación a {int(T_set)} °C', fontsize=14, fontweight='bold')

# Gráfico 1: Evolución de temperaturas
axs[0, 0].plot(t_min, Tw, 'r-', linewidth=1.8, label='T agua (baño)')
axs[0, 0].plot(t_min, Ts, 'b-', linewidth=1.8, label='T muestra')
axs[0, 0].axhline(T_set, color='k', linestyle='--', linewidth=1.3, label=f'Consigna = {T_set:.1f}°C')
axs[0, 0].axhline(T_env, color='gray', linestyle=':', linewidth=1.3, label='T ambiente')
axs[0, 0].set_title('Evolución de temperaturas')
axs[0, 0].set_xlabel('Tiempo (min)')
axs[0, 0].set_ylabel('Temperatura (°C)')
axs[0, 0].legend(loc='lower right')
axs[0, 0].grid(True, alpha=0.3)

# Gráfico 2: Señal de control PID (u)
axs[0, 1].plot(t_min, u_hist, 'g-', linewidth=1.8)
axs[0, 1].set_title('Señal de control PID (u)')
axs[0, 1].set_xlabel('Tiempo (min)')
axs[0, 1].set_ylabel('Apertura de resistencia (%)')
axs[0, 1].set_ylim(-5, 105)
axs[0, 1].grid(True, alpha=0.3)

# Gráfico 3: Balance de potencias
axs[1, 0].plot(t_min, P_cal, 'r-', linewidth=1.8, label='P calentador')
axs[1, 0].plot(t_min, P_perd, color='orange', linewidth=1.8, label='P pérdidas (ambiente)')
axs[1, 0].plot(t_min, P_util, 'b-', linewidth=1.8, label='P útil (a muestra)')
axs[1, 0].set_title('Balance de potencias')
axs[1, 0].set_xlabel('Tiempo (min)')
axs[1, 0].set_ylabel('Potencia (W)')
axs[1, 0].legend(loc='upper right')
axs[1, 0].grid(True, alpha=0.3)

# Gráfico 4: Error de regulación
axs[1, 1].plot(t_min, err_hist, 'm-', linewidth=1.8)
axs[1, 1].axhline(0, color='k', linestyle='--', linewidth=0.8, alpha=0.6)
axs[1, 1].set_title('Error de regulación (setpoint - T agua)')
axs[1, 1].set_xlabel('Tiempo (min)')
axs[1, 1].set_ylabel('Error (°C)')
axs[1, 1].grid(True, alpha=0.3)

plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.show()
